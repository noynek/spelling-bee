# Both pronunciation and spoken spelling use this server-only key.
ASSEMBLYAI_API_KEY=
SPEECH_PROVIDER=assemblyai
ASSEMBLYAI_STT_MODEL=universal-3-5-pro
ASSEMBLYAI_TTS_VOICE=aai-audrey

# Optional comparison providers and protected developer speech lab.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
DEEPGRAM_API_KEY=
SPEECH_LAB_TOKEN=

# Shared password for the app and speech routes. The form only asks for a password.
APP_PASSWORD=

# Separate random signing key (at least 32 characters). Do not reuse APP_PASSWORD.
APP_SESSION_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SPEECH_DAILY_LIMIT=500
